{
  "name": "cyber-idle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --import ./scripts/register-typescript.mjs --test tests/*.test.mjs",
    "audit": "node --import ./scripts/register-typescript.mjs scripts/audit-progression.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "balance:simulate": "node --import ./scripts/register-typescript.mjs scripts/simulate-progression.mjs",
    "balance:audit": "node --import ./scripts/register-typescript.mjs scripts/audit-balance.mjs",
    "audit:first-hour": "node --import ./scripts/register-typescript.mjs scripts/audit-first-hour.mjs",
    "audit:session": "node --import ./scripts/register-typescript.mjs scripts/audit-session.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
